# Reference only: index.ts does not automatically load .env files.
# Local mode keeps its embedded, loopback-only database by default.
APPLYMATE_ORIGIN=http://localhost:4174
APPLYMATE_PORT=7072
APPLYMATE_DATA_DIR=.applymate/local

# Optional cloud PostgreSQL foundation. Set these through managed secrets/environment,
# not by committing credentials. Requires the existing Azure identity/key/lease settings.
# APPLYMATE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# APPLYMATE_DATABASE_POOL_SIZE=5
# Non-loopback database hosts require verified TLS. SSL URL parameters are rejected.
# Existing pilot data is NOT migrated by setting this variable.
# Keep one API replica until durable independent workers are delivered.
